# Poort waar de capture-app luistert (serveert ook index.html)
PORT=3456

# SSH naar de machine waar de Ignis-vault op schijf staat
SSH_HOST=10.5.0.134
SSH_PORT=22
SSH_USER=jouw-gebruiker

# Private key: pad op de machine waar node draait, óf inline (zie SSH_PRIVATE_KEY)
SSH_PRIVATE_KEY_PATH=/home/jouw/.ssh/id_ed25519
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# SSH_PASSPHRASE=

# Absoluut pad naar de vault-map op de SSH-server (Ignis Docker: vaak .../vaults/My Vault)
VAULT_PATH=/pad/naar/vaults/My Vault

# Optioneel: map binnen de vault (kan in de UI worden overschreven)
NOTE_FOLDER=Inbox

# Optioneel: verplicht token in header X-Capture-Token (aanbevolen als de app bereikbaar is)
# CAPTURE_API_TOKEN=lang-geheim-token
