# Docker image (gebouwd via GitHub Actions → ghcr.io)
CAPTURE_IMAGE=ghcr.io/s4ndyp/quicknote:latest

# Poort op de host waar de capture-UI bereikbaar is
CAPTURE_PORT=8080

# Ignis server (zonder trailing slash). HTTPS + self-signed is ondersteund.
IGNIS_UPSTREAM=https://10.5.0.134

# Obsidian Local REST API op de Docker-host (Obsidian moet open staan).
OBSIDIAN_REST_UPSTREAM=https://host.docker.internal:27124

# Eerste keer pullen (als package private is):
# echo $GITHUB_TOKEN | docker login ghcr.io -u USERNAME --password-stdin
