{
  "manifest_version": 3,
  "name": "Ignis Quick Capture",
  "description": "Sla snel notities op in Obsidian via Local REST API, Ignis, of capture-proxy.",
  "version": "1.3.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ignis Quick Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://10.5.0.134/*",
    "https://10.5.0.134/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
